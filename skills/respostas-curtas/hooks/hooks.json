{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$HOME/.claude/respostas-curtas-nucleo-override.md\" 2>/dev/null || cat \"$CLAUDE_PLUGIN_ROOT/hooks/nucleo.md\"",
            "statusMessage": "Carregando o estilo respostas-curtas",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "command -v claude >/dev/null 2>&1 && claude plugin marketplace update claude-skill-concise >/dev/null 2>&1 && claude plugin update respostas-curtas@claude-skill-concise >/dev/null 2>&1 || true",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ]
  }
}
